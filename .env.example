# No Free-plan quotas. These are per-job technical safeguards, not subscription limits.
CRAWLER_MAX_PAGES=10000
CRAWLER_MAX_SECONDS=300
# Optional server default. Users can save their own encrypted key in Integrations.
SERPAPI_API_KEY=
# Leave local until a real domain is selected. Public origins must use HTTPS.
APP_BASE_URL=http://127.0.0.1:3000
# Production backend origin used by the Vercel frontend.
NEXT_PUBLIC_API_URL=https://api-siteradar.apps.taqat.academy
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
